{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Node",
    "strict": true,
    "jsx": "preserve",
    "sourceMap": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "lib": ["ESNext", "DOM"],
    "skipLibCheck": true,
    "paths": {
      "@/*": ["./src_fsd/*"],
      "@app/*": ["./src_fsd/app/*"],
      "@pages/*": ["./src_fsd/pages/*"],
      "@widgets/*": ["./src_fsd/widgets/*"],
      "@features/*": ["./src_fsd/features/*"],
      "@entities/*": ["./src_fsd/entities/*"],
      "@shared/*": ["./src_fsd/shared/*"]
    }
  },
  "include": ["src_fsd/**/*.ts", "src_fsd/**/*.d.ts", "src_fsd/**/*.tsx", "src_fsd/**/*.vue"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
