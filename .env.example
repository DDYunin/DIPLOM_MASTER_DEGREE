# Единый API gateway (относительный URL, маршрутизация через Vite/nginx по префиксу):
#   /api/users/...  → users service  (8080)
#   /api/course/... → course service (10001)
#   /api/files/...  → file service   (8087)

# Docker Compose — порт фронтенда на хосте
FRONTEND_PORT=8081

# Docker Compose — users service
BACKEND_HOST=host.docker.internal
BACKEND_PORT=8080

# Docker Compose — course service
COURSE_HOST=host.docker.internal
COURSE_PORT=10001

# Docker Compose — file service
FILE_HOST=host.docker.internal
FILE_PORT=8087
