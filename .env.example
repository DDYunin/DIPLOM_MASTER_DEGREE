# Локальная разработка (Vite)
VITE_API_URL=/api

# Docker Compose — порт фронтенда на хосте
FRONTEND_PORT=8081

# Docker Compose — куда nginx проксирует /api
# host.docker.internal — бэкенд на машине разработчика (Windows / macOS)
# backend — имя сервиса в docker-compose, если бэкенд в той же сети
BACKEND_HOST=host.docker.internal
BACKEND_PORT=8080
